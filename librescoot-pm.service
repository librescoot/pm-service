[Unit]
Description=Librescoot Power Management Service
After=valkey.service
After=librescoot-vehicle.service
Before=librescoot-battery.service
After=librescoot-settings.service
Requires=valkey.service

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/pm-service
Restart=on-failure
RestartSec=5
User=root
Group=root

[Install]
WantedBy=multi-user.target
RequiredBy=librescoot-battery.service
